{
  "name": "@livesession/libstylist-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for libstylist, the purist styling system for UI artisans.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm --filter @livesession/libstylist run dev",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm -r --filter './packages/*' run test",
    "change": "beachball change",
    "checkchange": "beachball check"
  },
  "devDependencies": {
    "beachball": "^2.66.0"
  }
}
