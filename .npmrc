# @livesession packages live in GitHub Packages, not the public registry. The
# registry is named here; the credential is not. pnpm ignores env-var
# credentials in a committed project .npmrc, so CI writes the auth at user
# level (the release workflows do, from the workflow token) and a developer
# does the same once: `pnpm config set
# //npm.pkg.github.com/:_authToken <a classic PAT with read:packages>`.
# libstylist itself depends on no @livesession package, so installing this
# workspace needs no token at all — only publishing does.
@livesession:registry=https://npm.pkg.github.com
